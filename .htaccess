# Activer le module de réécriture
RewriteEngine On

# Rediriger la page d'accueil vers login.html
RewriteRule ^$ /public/pages/login.html [L]

# Ne pas appliquer de règles aux fichiers existants
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Rediriger les autres requêtes vers Node.js
RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]